{
  "name": "studio",
  "version": "1.0.0",
  "private": true,
  "keywords": [
    "sanity"
  ],
  "license": "UNLICENSED",
  "main": "package.json",
  "scripts": {
    "build": "sanity build",
    "deploy": "sanity deploy",
    "dev": "sanity dev",
    "migrate-content": "node scripts/migrate-content.mjs",
    "schema:extract": "sanity schema extract --enforce-required-fields --path ../sanity.schema.json --force",
    "typegen": "sanity typegen generate",
    "sanity:typegen": "npm run schema:extract && npm run typegen",
    "start": "sanity start",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@sanity/assist": "^6.1.9",
    "@sanity/cli": "^8.11.0",
    "@sanity/icons": "^5.0.0",
    "@sanity/vision": "^6.13.2",
    "date-fns": "^4.4.0",
    "pluralize-esm": "^9.0.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rxjs": "^7.8.2",
    "sanity": "^6.13.2",
    "sanity-plugin-asset-source-unsplash": "^7.0.14",
    "sanity-plugin-media": "^5.0.10",
    "styled-components": "^6.4.3"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^6.0.0",
    "@types/react": "^19.2.17",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
