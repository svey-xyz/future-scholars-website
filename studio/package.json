{
  "name": "studio",
  "version": "1.0.0",
  "private": true,
  "keywords": [
    "sanity"
  ],
  "license": "UNLICENSED",
  "main": "package.json",
  "scripts": {
    "build": "sanity build",
    "deploy": "sanity deploy",
    "dev": "sanity dev",
    "sanity:typegen": "npm run schema:extract && npm run typegen",
    "schema:extract": "sanity schema extract --enforce-required-fields --path ../sanity.schema.json --force",
    "start": "sanity start",
    "type-check": "tsc --noEmit",
    "typegen": "sanity typegen generate"
  },
  "dependencies": {
    "@sanity/assist": "^6.2.6",
    "@sanity/cli": "^8.27.0",
    "@sanity/icons": "^5.2.3",
    "@sanity/vision": "^6.22.0",
    "pluralize-esm": "^9.0.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rxjs": "^7.8.2",
    "sanity": "^6.22.0",
    "sanity-plugin-asset-source-unsplash": "^7.0.30",
    "sanity-plugin-media": "^6.6.1",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
